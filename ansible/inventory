# Este arquivo é sobrescrito pelo OpenTofu (tofu apply) com os IPs reais.
# Se preferir preencher manualmente, troque os IPs abaixo.
[vm1]
IP_VM1 ansible_user=ubuntu ansible_ssh_private_key_file=~/.ssh/id_rsa ansible_ssh_common_args='-o StrictHostKeyChecking=no'

[vm2]
IP_VM2 ansible_user=ubuntu ansible_ssh_private_key_file=~/.ssh/id_rsa ansible_ssh_common_args='-o StrictHostKeyChecking=no'

[all:vars]
vm1_ip=IP_VM1
vm2_ip=IP_VM2
